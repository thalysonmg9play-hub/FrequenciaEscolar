<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FrequenciaEscolar.ViewModels"
             x:Class="FrequenciaEscolar.Views.TurmasView"
             x:DataType="vm:TurmasViewModel">

    <Grid ColumnDefinitions="*,320" Margin="20">

        <!-- Lista simples -->
        <DockPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock DockPanel.Dock="Top" 
                       Text="Turmas Cadastradas" 
                       FontSize="20" 
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <ListBox ItemsSource="{Binding Turmas}"
                     SelectedItem="{Binding TurmaSelecionada}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} - {1}">
                                    <Binding Path="Nome"/>
                                    <Binding Path="AnoLetivo"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Formulário -->
        <Border Grid.Column="1" 
                Background="White" 
                BorderBrush="#E2E8F0" 
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
            <StackPanel Spacing="15">
                <TextBlock Text="{Binding TituloFormulario}" 
                           FontSize="18" 
                           FontWeight="SemiBold"/>

                <StackPanel Spacing="5">
                    <TextBlock Text="Nome da Turma" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding NomeTurma}" PlaceholderText="Ex: 6º Ano A"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Ano Letivo" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding AnoLetivo}" PlaceholderText="Ex: 2026"/>
                    <TextBlock Text="{Binding Mensagem}"
           Foreground="#DC2626"
           TextWrapping="Wrap"
           FontWeight="SemiBold"/>
                </StackPanel>

                <Button Content="Salvar" 
                        Command="{Binding SalvarTurmaCommand}"
                        HorizontalAlignment="Stretch"
                        Padding="12"
                        Background="#3B82F6"
                        Foreground="White"
                        FontWeight="SemiBold"/>

                

                <Button Content="Editar Selecionada" 
                        Command="{Binding EditarTurmaCommand}"
                        HorizontalAlignment="Stretch"
                        Padding="12"/>

                <Button Content="Excluir Selecionada" 
                        Command="{Binding ExcluirTurmaCommand}"
                        HorizontalAlignment="Stretch"
                        Padding="12"
                        Background="#EF4444"
                        Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>