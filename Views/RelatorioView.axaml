<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FrequenciaEscolar.ViewModels"
             x:Class="FrequenciaEscolar.Views.RelatorioView"
             x:DataType="vm:RelatorioViewModel">

    <DockPanel Margin="20">

        <!-- Filtros -->
        <Border DockPanel.Dock="Top"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15">
            <StackPanel Spacing="12">
                <TextBlock Text="Relatório de Faltas"
                           FontSize="20"
                           FontWeight="Bold"/>

                <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="15">

                    <StackPanel Grid.Column="0" Spacing="5">
                        <TextBlock Text="Turma (opcional)" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Turmas}"
                                  SelectedItem="{Binding TurmaSelecionada}"
                                  PlaceholderText="Todas as turmas"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nome}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Text="Data Início" FontWeight="SemiBold"/>
                        <CalendarDatePicker SelectedDate="{Binding DataInicio}"
                                            HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="5">
                        <TextBlock Text="Data Fim" FontWeight="SemiBold"/>
                        <CalendarDatePicker SelectedDate="{Binding DataFim}"
                                            HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <Button Grid.Column="3"
                            Content="Gerar Relatório"
                            Command="{Binding GerarRelatorioCommand}"
                            VerticalAlignment="Bottom"
                            Padding="16,10"
                            Background="#3B82F6"
                            Foreground="White"
                            FontWeight="SemiBold"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Resultado -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding MensagemStatus}"
                       Margin="0,10,0,0"
                       FontWeight="SemiBold"
                       Foreground="#334155"/>

            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">

                <ListBox ItemsSource="{Binding Faltas}"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10"
                                    Margin="0,3"
                                    Background="#FEF2F2"
                                    CornerRadius="6"
                                    BorderBrush="#FECACA"
                                    BorderThickness="1">
                                <Grid ColumnDefinitions="2*,Auto,*,2*">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding NomeAluno}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Matricula}" FontSize="12" Foreground="#64748B"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Data, StringFormat={}{0:dd/MM/yyyy}}"
                                               VerticalAlignment="Center"
                                               Margin="15,0"
                                               FontWeight="SemiBold"
                                               Foreground="#DC2626"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding NomeTurma}"
                                               VerticalAlignment="Center"
                                               Foreground="#3B82F6"/>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Observacao}"
                                               VerticalAlignment="Center"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>
    </DockPanel>
</UserControl>